# -----------------------------------------------------------------------------
# Global Environment Variables Example
# Copy this file to .env in backend/ and chatbot/, or .env.local in frontend/ and admin/
# -----------------------------------------------------------------------------

# General App Configurations
PROJECT_NAME="Vision Infra - Vision Amanya"
ENVIRONMENT=development # development, staging, production
API_V1_STR=/api/v1

# Frontend / Web Settings
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Admin Portal Settings
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001

# Backend / API Settings
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Security (JWT Auth)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=supersecretjwtkeyplaceholderchangeinproduction
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vision_amanya

# Database URL Configurations
# Native/Host connection:
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/vision_amanya
# Async connection (FastAPI):
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/vision_amanya

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Artificial Intelligence (LangChain & OpenAI-compatible SDK)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Vector Database (ChromaDB / FAISS)
VECTOR_DB_TYPE=chroma # chroma, faiss
PERSIST_DIRECTORY=./chromadb_store
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
