# -----------------------------------------------------------------------------
# Vision Amanya — Frontend Environment Variables
# Copy this file to `.env.local` and adjust values for your environment.
# NEVER commit real secrets. Only `NEXT_PUBLIC_*` variables are exposed to the
# browser; everything else is available exclusively to the Next.js server.
# -----------------------------------------------------------------------------

# --- App --------------------------------------------------------------------
# Canonical public origin of the website (used for SEO, cookies, absolute URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Human-friendly identifiers used in metadata, the manifest and the UI.
NEXT_PUBLIC_APP_NAME=Vision Amanya
NEXT_PUBLIC_APP_DESCRIPTION=Luxury residential residences by Vision Infra Developers, Khajaguda, Hyderabad.

# Comma separated list of locales the app supports (default locale first).
NEXT_PUBLIC_SUPPORTED_LOCALES=en
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Backend API -------------------------------------------------------------
# Base URL of the FastAPI backend (client-side calls go straight here; the
# backend CORS allow-list must include this site's origin).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Base URL of media/uploads if served from a different host than the API.
NEXT_PUBLIC_MEDIA_URL=http://localhost:8000

# --- Server-only (never exposed to the browser) --------------------------------
# Base URL the Next.js route handlers (BFF) use when proxying to FastAPI.
API_URL=http://localhost:8000/api/v1

# Session cookie configuration for the refresh-token cookie managed by the BFF.
# `SESSION_COOKIE_SECURE` must be `true` when served over HTTPS.
SESSION_COOKIE_NAME=va_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=localhost
# Refresh token lifetime in seconds (must stay <= backend REFRESH_TOKEN_EXPIRE_MINUTES * 60).
SESSION_MAX_AGE_SECONDS=2592000
